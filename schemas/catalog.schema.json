{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-router.invalid/schemas/catalog.schema.json",
  "title": "Immutable resolved skill catalog snapshot",
  "description": "Local schema identifier, not a network endpoint. Semantic hash, membership and eligibility checks are specified in docs/architecture.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_sha256", "captured_at", "loader_contract", "eligibility_sha256", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_sha256": {"$ref": "#/$defs/digest"},
    "captured_at": {"$ref": "#/$defs/utc"},
    "loader_contract": {"type": "string", "minLength": 1},
    "eligibility_sha256": {"$ref": "#/$defs/digest"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "contextualMemberIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["target_sha256", "rubric_sha256", "schema_sha256", "annotation_sha256", "receipt_sha256", "catalog_sha256", "source_dataset_sha256", "dataset_schema_sha256", "source_contract_sha256", "role_plan_sha256", "identity_map_sha256", "projection_sha256"],
      "properties": {
        "target_sha256": {"$ref": "#/$defs/digest"},
        "rubric_sha256": {"$ref": "#/$defs/digest"},
        "schema_sha256": {"$ref": "#/$defs/digest"},
        "annotation_sha256": {"$ref": "#/$defs/digest"},
        "receipt_sha256": {"$ref": "#/$defs/digest"},
        "catalog_sha256": {"$ref": "#/$defs/digest"},
        "source_dataset_sha256": {"$ref": "#/$defs/digest"},
        "dataset_schema_sha256": {"$ref": "#/$defs/digest"},
        "source_contract_sha256": {"$ref": "#/$defs/digest"},
        "role_plan_sha256": {"$ref": "#/$defs/digest"},
        "identity_map_sha256": {"$ref": "#/$defs/digest"},
        "projection_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "contextualBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "target_sha256", "catalog_sha256", "source_set_sha256", "runtime_revision", "approval_sha256", "purpose", "fixture_only", "members"],
      "properties": {
        "version": {"const": 1},
        "target_sha256": {"$ref": "#/$defs/digest"},
        "catalog_sha256": {"$ref": "#/$defs/digest"},
        "source_set_sha256": {"$ref": "#/$defs/digest"},
        "runtime_revision": {"$ref": "#/$defs/digest"},
        "approval_sha256": {"$ref": "#/$defs/digest"},
        "purpose": {"const": "local-canonical-integration"},
        "fixture_only": {"type": "boolean"},
        "members": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["member_sha256", "identity", "approval_sha256"],
            "properties": {
              "member_sha256": {"$ref": "#/$defs/digest"},
              "identity": {"$ref": "#/$defs/contextualMemberIdentity"},
              "approval_sha256": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "compactContextualBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "target_sha256", "catalog_sha256", "source_set_sha256", "runtime_revision", "approval_sha256", "purpose", "fixture_only"],
      "properties": {
        "version": {"const": 1},
        "target_sha256": {"$ref": "#/$defs/digest"},
        "catalog_sha256": {"$ref": "#/$defs/digest"},
        "source_set_sha256": {"$ref": "#/$defs/digest"},
        "runtime_revision": {"$ref": "#/$defs/digest"},
        "approval_sha256": {"$ref": "#/$defs/digest"},
        "purpose": {"const": "local-canonical-integration"},
        "fixture_only": {"type": "boolean"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "declared_name", "description", "content_sha256", "routing_sha256", "resource_tree_sha256", "source_kind", "source_ref", "hidden", "automatic_eligible", "explicit_eligible", "family_id"],
      "properties": {
        "runtime_id": {"$ref": "#/$defs/id"},
        "declared_name": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "content_sha256": {"$ref": "#/$defs/digest"},
        "routing_sha256": {"$ref": "#/$defs/digest"},
        "resource_tree_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "source_kind": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1, "description": "Opaque local provenance key. Never an inference-supplied path."},
        "hidden": {"type": "boolean"},
        "automatic_eligible": {"type": "boolean"},
        "explicit_eligible": {"type": "boolean"},
        "family_id": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"hidden": {"const": true}}}, "then": {"properties": {"automatic_eligible": {"const": false}}}},
        {"if": {"properties": {"automatic_eligible": {"const": true}}}, "then": {"properties": {"description": {"minLength": 1}, "explicit_eligible": {"const": true}}}}
      ]
    },
    "artifactManifest": {
      "title": "Immutable experiment artifact manifest",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_sha256", "kind", "created_at", "files", "parents", "catalog_sha256", "dataset_sha256", "split_sha256", "recipe_sha256", "base_model_revision", "runtime_revision", "privacy_class", "publication_allowed"],
      "properties": {
        "contextual_binding": {"$ref": "#/$defs/contextualBinding"},
        "schema_version": {"const": 1},
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["dataset", "split", "model", "calibration", "evaluation", "package"]},
        "created_at": {"$ref": "#/$defs/utc"},
        "files": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "description": "Relative artifact path; reject absolute paths, traversal, duplicate paths and escaping symlinks semantically."},
              "sha256": {"$ref": "#/$defs/digest"},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        },
        "parents": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "catalog_sha256": {"$ref": "#/$defs/digest"},
        "dataset_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "split_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "recipe_sha256": {"$ref": "#/$defs/digest"},
        "base_model_revision": {"type": ["string", "null"]},
        "runtime_revision": {"type": "string", "minLength": 1},
        "privacy_class": {"enum": ["private_local", "approved_remote_private"]},
        "publication_allowed": {"const": false}
      }
    }
  }
}
